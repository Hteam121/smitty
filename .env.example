# Copy to .env (git-ignored) and uncomment what you want to change.
# Anything set in your shell wins over this file. Defaults are in smitty/config.py.

# --- You ---
# SMITTY_USER_NAME=Alex                 # what Smitty calls you (default: "the user")
# SMITTY_PROJECT_ROOTS=~/Desktop:~/code # colon-separated folders that hold your projects (default: ~/Desktop)
# SMITTY_TASKS_DIR=~/Desktop/smitty-tasks   # where non-coding jobs run (email, calendar, research)
# SMITTY_UNITS=f                        # weather units: f or c

# --- Claude ---
# SMITTY_AUTH=login                     # login = your claude.ai subscription (default); api_key = bill ANTHROPIC_API_KEY
# SMITTY_BRAIN_MODEL=claude-opus-5-5
# SMITTY_BRAIN_EFFORT=low
# SMITTY_WORKER_MODEL=                  # empty = Claude Code's own default. Both models can also be picked in the dashboard

# --- Voice ---
# SMITTY_AUDIO=usb                      # usb (reSpeaker on the cable) or websocket (XIAO ESP32S3 over Wi-Fi)
# SMITTY_WAKE_MODEL=hey_smitty          # a model in ./models or one bundled with openWakeWord, e.g. hey_jarvis
# SMITTY_WAKE_THRESHOLD=0.7
# SMITTY_WAKE_VERIFY=strict            # strict expects to hear "smitty"; use log with another wake word
# SMITTY_VOICE=bm_george                # Kokoro voice
# SMITTY_TTS=kokoro                     # kokoro or say (macOS built-in)
# SMITTY_VOLUME=0.5                     # 0..1
# SMITTY_LEDS=1                         # 0 = leave the reSpeaker LED ring alone
# SMITTY_ATTENTION=active               # active (speaks) or passive (inbox only)
# SMITTY_QUIET_HOURS=23-7               # hold scheduled results overnight

# --- Optional parts ---
# SMITTY_VAULT_DIR=~/Documents/MyVault  # your Obsidian vault folder; notes are off until this is set
# SMITTY_BROWSER_PROFILE=Default        # the one Ego Lite profile sessions may use
# SMITTY_HUB_URL=https://<project>.supabase.co   # phone/Watch hub; or put both in ~/.smitty/hub.json
# SMITTY_HUB_KEY=                       # the hub's SECRET key. Never commit it.
# SMITTY_DASHBOARD=1                    # 0 = no dashboard
# SMITTY_DASHBOARD_PORT=8770
